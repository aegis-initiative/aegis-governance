{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-initiative.com/schemas/common/actor.schema.json",
  "title": "Actor",
  "type": "object",
  "required": ["id", "type"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique actor identifier, such as agent-soc-001. aegis_core's own validation (AEGIS-VAL-004) only allows alphanumeric characters, hyphens, underscores, and dots -- not colons."
    },
    "type": {
      "type": "string",
      "enum": ["ai-agent", "ai-copilot", "automation", "human"]
    },
    "role": {
      "type": "string",
      "minLength": 1
    }
  }
}
