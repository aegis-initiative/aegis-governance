{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-initiative.com/schemas/agp/decision_response.schema.json",
  "title": "AGP DECISION_RESPONSE",
  "type": "object",
  "required": ["message_type", "action_id", "decision", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "message_type": { "const": "DECISION_RESPONSE" },
    "action_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "decision": {
      "$ref": "https://aegis-initiative.com/schemas/common/decision.schema.json"
    },
    "reason": {
      "type": "string"
    },
    "policy_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0.0,
      "description": "Computed risk score for the evaluated action. Not produced by every implementation -- a decision engine without risk scoring simply omits this field."
    },
    "audit_ref": {
      "type": "string",
      "description": "Reference to the full audit trail entry for this decision, if the implementation maintains one."
    }
  }
}
