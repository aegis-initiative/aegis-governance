{
  "name": "aegis-governance-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/sync-references.mjs && node scripts/sync-atx.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-references.mjs && node scripts/sync-atx.mjs",
    "build": "astro build && pagefind --site dist",
    "postbuild": "node -e \"const fs=require('node:fs');fs.cpSync('dist/pagefind','public/pagefind',{recursive:true,force:true});\"",
    "preview": "astro preview",
    "sync-references": "node scripts/sync-references.mjs",
    "sync-atx": "node scripts/sync-atx.mjs",
    "sync-atx:check": "node scripts/sync-atx.mjs --check"
  },
  "dependencies": {
    "@aegis-initiative/design-system": "^0.7.0",
    "@astrojs/sitemap": "^3.7.2",
    "@pagefind/default-ui": "^1.5.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "pagefind": "^1.5.0"
  }
}
