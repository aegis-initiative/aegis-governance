---
import { getCollection, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PrevNext from '../components/PrevNext.astro';
import { nav, type NavItem } from '../components/Sidebar.astro';

// Flatten the sidebar's nav tree into a single ordered list, so prev/next
// is always derived from the same source as the sidebar itself rather than
// a second hand-maintained array that can drift out of sync (see
// aegis-initiative/aegis-initiative#66). Only leaf items are included:
// every group's own slug duplicates its first child's slug (e.g.
// "Foundation" and its "Manifesto" child both point at /foundation/) --
// including both would put that page in navOrder twice and make it point
// at itself as its own "next".
function flattenNav(items: NavItem[]): { slug: string; label: string }[] {
  return items.flatMap((item) =>
    item.items ? flattenNav(item.items) : [{ slug: item.slug, label: item.label }]
  );
}

const navOrder = flattenNav(nav);

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id;

// Build breadcrumbs
const parts = slug.split('/');
const section = parts[0];
const sectionLabels: Record<string, string> = {
  foundation: 'Foundation',
  architecture: 'Architecture',
  protocol: 'Protocol (AGP-1)',
  'threat-model': 'Threat Model',
  identity: 'Identity (AIAM-1)',
  federation: 'Federation (GFN-1)',
  rfc: 'RFCs',
  releases: 'Releases',
};

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

const breadcrumbs: { label: string; href?: string }[] = [];

if (section === 'releases' && parts.length >= 3) {
  // Release-notes pages have a /releases/YY/M/[D]/ path. There is no
  // /releases/YY/ index, so collapse year+month into a flat label.
  const yy = parts[1];
  const month = parts[2];
  const day = parts[3];
  const year = 2000 + parseInt(yy, 10);
  const monthIdx = parseInt(month, 10) - 1;
  const monthName = MONTH_NAMES[monthIdx] ?? month;

  breadcrumbs.push({ label: 'Releases', href: '/releases/' });
  if (day !== undefined) {
    // Daily dev-log: AEGIS Governance > Releases > April 12, 2026
    breadcrumbs.push({ label: entry.data.title });
  } else {
    // Monthly: AEGIS Governance > Releases > April 2026
    breadcrumbs.push({ label: `${monthName} ${year}` });
  }
} else if (sectionLabels[section]) {
  if (parts.length === 1 || (parts.length === 2 && parts[1] === 'index')) {
    breadcrumbs.push({ label: sectionLabels[section] });
  } else {
    breadcrumbs.push({ label: sectionLabels[section], href: `/${section}/` });
    breadcrumbs.push({ label: entry.data.title });
  }
}

// Compute prev/next
const navIdx = navOrder.findIndex((n) => n.slug === slug);
const prev = navIdx > 0 ? { label: navOrder[navIdx - 1].label, href: `/${navOrder[navIdx - 1].slug}/` } : undefined;
const next = navIdx >= 0 && navIdx < navOrder.length - 1 ? { label: navOrder[navIdx + 1].label, href: `/${navOrder[navIdx + 1].slug}/` } : undefined;
---

<DocLayout title={entry.data.title} description={entry.data.description}>
  {breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} slot="breadcrumb" />}
  <Content />
  <PrevNext prev={prev} next={next} />
</DocLayout>
